rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'aplicacionisola@gmail.com' ||
        request.auth.token.email == 'admin@isola.com'
      );
    }

    // Allow connection test
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn() || true;
      allow delete: if isBootstrappedAdmin() || isSignedIn();
    }

    // Machinery fleet (Equipos)
    match /equipos/{equipoId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Horometros
    match /horometros/{horometroId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Combustible
    match /combustible/{combustibleId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
